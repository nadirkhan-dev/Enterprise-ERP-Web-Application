# Directus Backend
DIRECTUS_URL=https://your-directus-instance.com
DIRECTUS_TOKEN=your-static-token-here

# Nuxt Public Runtime Config (baked into client bundle at build time)
NUXT_PUBLIC_DIRECTUS_URL=https://your-directus-instance.com

# Directus Realtime WebSocket (direct URL — bypasses Nuxt proxy)
NUXT_PUBLIC_DIRECTUS_WEBSOCKET_URL=wss://your-directus-instance.com/websocket

# Password Reset — where the Directus email sends users to finish the reset.
# Leave this unset and Directus falls back to its own project_url (SupplyHub),
# which is how reset links ended up on the wrong app. The value must ALSO be on
# Directus's PASSWORD_RESET_URL_ALLOW_LIST, or Directus rejects the request.
NUXT_PUBLIC_PASSWORD_RESET_URL=https://connect.libertysupply.dev/password-reset

# SAP B1 Service Layer
NUXT_SAP_SERVICE_LAYER_URL=https://your-sap-service-layer.example.com/b1s/v1
NUXT_SAP_COMPANY_DB=your-company-db
NUXT_SAP_USERNAME=your-sap-username
NUXT_SAP_PASSWORD=your-sap-password
# Set to true only for environments using a self-signed SAP Service Layer certificate.
NUXT_SAP_ALLOW_SELF_SIGNED_CERT=false

# Looker (server-only)
NUXT_LOOKER_BASE_URL=https://your-instance.cloud.looker.com
NUXT_LOOKER_CLIENT_ID=your-looker-client-id
NUXT_LOOKER_CLIENT_SECRET=your-looker-client-secret

# Server
PORT=3000

# ---------------------------------------------------------------------------
# Deployed stack identity (docker/compose.yaml, docker/compose.prod.yaml)
# ---------------------------------------------------------------------------
# These are NOT read by the app — they configure the container itself, and are
# only used on the deploy host. Set them as VARIABLES on the `development` and
# `production` GitHub environments; the workflow renders them into the .env it
# writes beside the compose file.
#
# All are REQUIRED for a deploy: the workflow validates every one and fails by
# name before it builds anything. The compose files carry :-defaults matching
# the values below, but those only apply to a hand-run `docker compose up` on
# the host — a deploy never reaches them. This file documents what each
# environment should hold, so editing it changes nothing on its own.
#
#                                development                     production
#   COMPOSE_APP_CONTAINER_NAME   connect                         connect-prod
#   COMPOSE_APP_IMAGE            ghcr.io/libertysupply/connect   (same)
#   COMPOSE_APP_VERSION          dev                             prod
#   COMPOSE_APP_PORT             5175                            5177
#   COMPOSE_APP_CPUS             2.0                             2.0
#   COMPOSE_APP_MEM_LIMIT        2g                              2g
#   COMPOSE_APP_MEM_RESERVATION  512m                            512m
#   COMPOSE_APP_LOGGING_MAX_SIZE 10m                             10m
#   COMPOSE_APP_LOGGING_MAX_FILE 5                               5
#   COMPOSE_NETWORK_NAME         proxy                           proxy
#   PORT                         3000                            3000
#
# A second external network each stack joins so Nitro reaches sibling
# containers by name over the Docker bridge instead of going out to Cloudflare
# and back — the dev `servicemaster` ws://servicemaster:4114/api/syncworker/ws/jobs
# feed, and on either side the Directus that shares that network. The value is
# whichever network the corresponding `servicemaster` container is actually on:
# `supplyhubdev` for dev, `supplyhub` for prod. Both stacks keep `proxy` as
# their default network, which is how they are served publicly — this is an
# additional network, never a replacement.
#
# A `servicemaster` network also exists but has nothing attached to it, so
# joining that one resolves nothing. Verify before changing either value:
#   docker inspect <servicemaster container> \
#     --format '{{range $n,$_ := .NetworkSettings.Networks}}{{$n}} {{end}}'
#   COMPOSE_SERVICEMASTER_NETWORK_NAME   supplyhubdev             supplyhub
#
# COMPOSE_APP_MEM_LIMIT is a hard OOM-kill ceiling for the Nitro SSR server —
# check `docker stats` before lowering it.

# Figma MCP Server
FIGMA_API_KEY=your-figma-api-key-here

# FedEx Developer API (server-only)
# Sandbox: apis-sandbox.fedex.com — Production: apis.fedex.com
# The host and which variables below hold the credentials come from the `fedex`
# provider row in Directus; these are the fallback when it can't be read. The
# secrets themselves live only here — Directus stores variable names, not values.
NUXT_FEDEX_API_KEY=your-fedex-api-key
NUXT_FEDEX_SECRET_KEY=your-fedex-secret-key
NUXT_FEDEX_SHIPPER_ACCOUNT=your-fedex-shipper-account
NUXT_FEDEX_ACCOUNT=your-fedex-master-account
NUXT_FEDEX_BILL_TO_ACCOUNT=your-fedex-bill-to-account
NUXT_FEDEX_ENV=sandbox

# UPS Developer API (server-only)
# Test: wwwcie.ups.com — Production: onlinetools.ups.com
# Resolved from the `ups` provider row in Directus, falling back to these.
NUXT_UPS_CLIENT_ID=your-ups-client-id
NUXT_UPS_CLIENT_SECRET=your-ups-client-secret
NUXT_UPS_SHIPPER_NUMBER=
NUXT_UPS_ENV=test

# Square (cards-on-file)
# The Application ID prefix determines the environment automatically:
#   sandbox-sq0idb-... → sandbox  (SDK + API hit *.squareupsandbox.com)
#   sq0idp-...         → production (SDK + API hit *.squareup.com)
# App ID + Location ID MUST come from the same row in the Square dashboard
# as the Access Token, otherwise card tokenization is rejected.
NUXT_PUBLIC_SQUARE_APPLICATION_ID=sandbox-sq0idb-your-app-id
NUXT_PUBLIC_SQUARE_LOCATION_ID=your-location-id
NUXT_SQUARE_ACCESS_TOKEN=your-square-access-token

# PDF Render Service (server-only) — renders SAP documents to PDF by DocEntry.
# Basic Auth; the browser never sees these — requests proxy through /api/documents/render.
NUXT_PDF_DOWNLOAD_SERVICE_URL=http://render-service-host:3000
NUXT_PDF_DOWNLOAD_SERVICE_USER_NAME=admin
NUXT_PDF_DOWNLOAD_SERVICE_USER_PASS=your-render-service-password

# Ship-from origin is now configured in Directus.
# Mark a `warehouses` row with `is_default_shipper=true` and link an `addresses` row.

# Cloudflare Turnstile (bot protection for the enterprise inquiry form)
NUXT_PUBLIC_TURNSTILE_SITE_KEY=your-turnstile-site-key
NUXT_TURNSTILE_SECRET_KEY=your-turnstile-secret-key

# Microsoft Forms responses endpoint for the enterprise inquiry form
NUXT_MS_FORM_RESPONSES_URL=

# Asana (server-only) — in-app tool / feature / bug requests are filed as tasks
# in the CONNECT project's Backlog, tagged by request type. The access token is a
# personal access token (ideally a service account's) and can write anywhere in
# the workspace, so it stays server-side; the browser only ever calls
# /api/asana/*. The gids below are for the "Connect" project in the
# libertysupply.com workspace — re-read them if the project is ever recreated.
NUXT_ASANA_ACCESS_TOKEN=your-asana-personal-access-token
NUXT_ASANA_PROJECT_GID=1211969111764510
NUXT_ASANA_BACKLOG_SECTION_GID=1211969732442598
NUXT_ASANA_FEATURE_REQUEST_TAG_GID=1217071196239813
NUXT_ASANA_BUG_REPORT_TAG_GID=1217071196239812
# Optional. The CONNECT board tracks status as a section AND as this parallel
# custom field, and the team keeps the two in sync — so these set the new task's
# Status to Backlog to match. Leave them unset and the task still files, just with
# an empty Status.
NUXT_ASANA_STATUS_FIELD_GID=1211942009127239
NUXT_ASANA_BACKLOG_STATUS_OPTION_GID=1211942009127240
NUXT_ASANA_TASK_TYPE_GID=1211925437554233
NUXT_ASANA_TASK_TYPE_BACKLOG_STATUS_GID=1211925437554228

# Service Master (SAP sync worker) — server-side only. Connect's Nitro connects
# to the Service Master WebSocket with these CF Access service-token headers +
# Bearer key to watch a new partner's sync job, then relays status to the browser
# over SSE (/api/sap-sync/events). The browser never sees these.
# Priority1 — LTL freight broker rating (server-side only, never in the client
# bundle). Sandbox is dev-api; production is api.priority1.com. Auth is the
# X-API-KEY header. NOTE: no space before "=" — a shell `source .env` silently
# skips "KEY =value".
# Priority1 has no `providers` row yet, so these are what it runs on. Add one
# with code `priority1` and it takes over, the same way fedex/ups do.
NUXT_PRIORITY_ONE_API_URL=https://dev-api.priority1.com
NUXT_PRIORITY_ONE_API_KEY=your-priority1-api-key

NUXT_SERVICEMASTER_WS_URL=wss://servicemaster.libertysupply.dev/api/syncworker/ws/jobs
NUXT_SERVICEMASTER_API_KEY=your-service-master-api-key
NUXT_CF_ACCESS_CLIENT_ID=your-cf-access-service-token-id
NUXT_CF_ACCESS_CLIENT_SECRET=your-cf-access-service-token-secret

NUXT_OPENAI_API_KEY=your-openai-api-key
