# Directus Backend
DIRECTUS_URL=https://your-directus-instance.com
DIRECTUS_TOKEN=your-static-token-here

# Nuxt Public Runtime Config (baked into client bundle at build time)
NUXT_PUBLIC_DIRECTUS_URL=https://your-directus-instance.com

# Directus Realtime WebSocket (direct URL — bypasses Nuxt proxy)
NUXT_PUBLIC_DIRECTUS_WEBSOCKET_URL=wss://your-directus-instance.com/websocket

# Password Reset — where the Directus email sends users to finish the reset.
# Leave this unset and Directus falls back to its own project_url (SupplyHub),
# which is how reset links ended up on the wrong app. The value must ALSO be on
# Directus's PASSWORD_RESET_URL_ALLOW_LIST, or Directus rejects the request.
NUXT_PUBLIC_PASSWORD_RESET_URL=https://connect.libertysupply.dev/password-reset

# SAP B1 Service Layer
NUXT_SAP_SERVICE_LAYER_URL=https://your-sap-service-layer.example.com/b1s/v1
NUXT_SAP_COMPANY_DB=your-company-db
NUXT_SAP_USERNAME=your-sap-username
NUXT_SAP_PASSWORD=your-sap-password
# Set to true only for environments using a self-signed SAP Service Layer certificate.
NUXT_SAP_ALLOW_SELF_SIGNED_CERT=false

# Looker (server-only)
NUXT_LOOKER_BASE_URL=https://your-instance.cloud.looker.com
NUXT_LOOKER_CLIENT_ID=your-looker-client-id
NUXT_LOOKER_CLIENT_SECRET=your-looker-client-secret

# Server
PORT=3000

# Figma MCP Server
FIGMA_API_KEY=your-figma-api-key-here

# FedEx Developer API (server-only)
# Sandbox: apis-sandbox.fedex.com — Production: apis.fedex.com
NUXT_FEDEX_API_KEY=your-fedex-api-key
NUXT_FEDEX_SECRET_KEY=your-fedex-secret-key
NUXT_FEDEX_SHIPPER_ACCOUNT=your-fedex-shipper-account
NUXT_FEDEX_ACCOUNT=your-fedex-master-account
NUXT_FEDEX_BILL_TO_ACCOUNT=your-fedex-bill-to-account
NUXT_FEDEX_ENV=sandbox

# UPS Developer API (server-only)
# Test: wwwcie.ups.com — Production: onlinetools.ups.com
NUXT_UPS_CLIENT_ID=your-ups-client-id
NUXT_UPS_CLIENT_SECRET=your-ups-client-secret
NUXT_UPS_SHIPPER_NUMBER=
NUXT_UPS_ENV=test

# Square (cards-on-file)
# The Application ID prefix determines the environment automatically:
#   sandbox-sq0idb-... → sandbox  (SDK + API hit *.squareupsandbox.com)
#   sq0idp-...         → production (SDK + API hit *.squareup.com)
# App ID + Location ID MUST come from the same row in the Square dashboard
# as the Access Token, otherwise card tokenization is rejected.
NUXT_PUBLIC_SQUARE_APPLICATION_ID=sandbox-sq0idb-your-app-id
NUXT_PUBLIC_SQUARE_LOCATION_ID=your-location-id
NUXT_SQUARE_ACCESS_TOKEN=your-square-access-token

# PDF Render Service (server-only) — renders SAP documents to PDF by DocEntry.
# Basic Auth; the browser never sees these — requests proxy through /api/documents/render.
NUXT_PDF_DOWNLOAD_SERVICE_URL=http://render-service-host:3000
NUXT_PDF_DOWNLOAD_SERVICE_USER_NAME=admin
NUXT_PDF_DOWNLOAD_SERVICE_USER_PASS=your-render-service-password

# Ship-from origin is now configured in Directus.
# Mark a `warehouses` row with `is_default_shipper=true` and link an `addresses` row.

# Cloudflare Turnstile (bot protection for the enterprise inquiry form)
NUXT_PUBLIC_TURNSTILE_SITE_KEY=your-turnstile-site-key
NUXT_TURNSTILE_SECRET_KEY=your-turnstile-secret-key

# Microsoft Forms responses endpoint for the enterprise inquiry form
NUXT_MS_FORM_RESPONSES_URL=

# Service Master (SAP sync worker) — server-side only. Connect's Nitro connects
# to the Service Master WebSocket with these CF Access service-token headers +
# Bearer key to watch a new partner's sync job, then relays status to the browser
# over SSE (/api/sap-sync/events). The browser never sees these.
NUXT_SERVICEMASTER_WS_URL=wss://servicemaster.libertysupply.dev/ws/jobs
NUXT_SERVICEMASTER_API_KEY=your-service-master-api-key
NUXT_CF_ACCESS_CLIENT_ID=your-cf-access-service-token-id
NUXT_CF_ACCESS_CLIENT_SECRET=your-cf-access-service-token-secret
